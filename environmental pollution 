Here's a simple C program that simulates an environment pollution tracking system. This program allows users to input pollution data and view the output.

```
#include <stdio.h>
#include <string.h>

// Structure to represent pollution data
typedef struct {
    char location[50];
    int airQualityIndex;
    int waterPollutionLevel;
    int noisePollutionLevel;
} PollutionData;

// Function to get pollution data from user
void getPollutionData(PollutionData *data) {
    printf("Enter location: ");
    fgets(data->location, sizeof(data->location), stdin);
    data->location[strcspn(data->location, "\n")] = 0; // Remove newline character

    printf("Enter air quality index (1-500): ");
    scanf("%d", &data->airQualityIndex);
    getchar(); // Consume newline character

    printf("Enter water pollution level (1-100): ");
    scanf("%d", &data->waterPollutionLevel);
    getchar(); // Consume newline character

    printf("Enter noise pollution level (1-100): ");
    scanf("%d", &data->noisePollutionLevel);
    getchar(); // Consume newline character
}

// Function to display pollution data
void displayPollutionData(PollutionData data) {
    printf("Location: %s\n", data.location);
    printf("Air Quality Index: %d\n", data.airQualityIndex);
    printf("Water Pollution Level: %d\n", data.waterPollutionLevel);
    printf("Noise Pollution Level: %d\n", data.noisePollutionLevel);
}

// Function to classify pollution level
void classifyPollutionLevel(PollutionData data) {
    printf("Pollution Classification:\n");

    if (data.airQualityIndex <= 50) {
        printf("Air Quality: Good\n");
    } else if (data.airQualityIndex <= 100) {
        printf("Air Quality: Moderate\n");
    } else {
        printf("Air Quality: Poor\n");
    }

    if (data.waterPollutionLevel <= 30) {
        printf("Water Pollution: Low\n");
    } else if (data.waterPollutionLevel <= 60) {
        printf("Water Pollution: Moderate\n");
    } else {
        printf("Water Pollution: High\n");
    }

    if (data.noisePollutionLevel <= 40) {
        printf("Noise Pollution: Low\n");
    } else if (data.noisePollutionLevel <= 80) {
        printf("Noise Pollution: Moderate\n");
    } else {
        printf("Noise Pollution: High\n");
    }
}

int main() {
    PollutionData data;

    printf("Environment Pollution Tracking System\n");
    printf("-------------------------------------\n");

    getPollutionData(&data);

    printf("\nPollution Data:\n");
    displayPollutionData(data);

    printf("\n");
    classifyPollutionLevel(data);

    return 0;
}
